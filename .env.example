# Sentinel NIDS Frontend Environment Configuration
# API Base URL for backend communication (Django backend)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Enable mock mode during development when backend endpoints are offline
# Set to 'false' to connect directly to the real Django backend
VITE_USE_MOCK_DATA=true

# API request timeout in milliseconds
VITE_API_TIMEOUT_MS=10000
